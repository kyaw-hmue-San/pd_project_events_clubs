# Compatibility local template. Hosted settings: config/env/backend.production.env.example.
# Copy to backend/.env only for a fresh setup. Do not overwrite existing secrets.
# Run local commands from the repository root.
FIREBASE_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=./backend/service-account.local.json
NODE_ENV=development
FRONTEND_ORIGINS=http://localhost:5173
SCHOOL_EMAIL_DOMAIN=lamduan.mfu.ac.th
PORT=3000

# Optional AI; without a provider key planning falls back to a labelled template.
AIML_API_KEY=
AIML_MODEL=google/gemini-2.5-flash
ORGANIZER_AI_AUTO_APPROVE=false
# Set CAMPUS_ORGANIZER_V1 only when enabling the confirmed policy explicitly.
ORGANIZER_AI_POLICY=

# Optional coordinated maintenance test; keys are exchanged privately.
# Normal dev:api disables integrations. Select dev:api:facilities explicitly.
WEBHOOK_INBOUND_SECRET=
TEAM10_PARTNER_KEY=
TEAM10_WORK_ORDER_API_URL=https://maintenanceteam10.vercel.app/api/partner/work-orders
# For an approved local partner tunnel, replace the URL above privately.

# Existing general partner API/publication connection is independent of facilities.
PARTNER_INBOUND_API_KEY=
PARTNER_API_URL=
PARTNER_API_HEADER_NAME=X-Partner-Key
PARTNER_API_TOKEN=
PARTNER_WEBHOOK_URL=
WEBHOOK_OUTBOUND_SECRET=
INTEGRATION_LOG_VIEWER_UIDS=
