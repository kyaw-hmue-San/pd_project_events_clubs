# Public Firebase WEB configuration only. Never put Admin SDK credentials here.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_API_BASE_URL=http://localhost:3000
# Confirm the university's timezone before deployment.
VITE_CAMPUS_TIME_ZONE=Asia/Bangkok
# Only enable with a demo-* project and the isolated local emulators.
VITE_USE_EMULATORS=false
VITE_SCHOOL_EMAIL_DOMAIN=lamduan.mfu.ac.th
