# Backend environment for Render. These values contain no private key.
FIREBASE_PROJECT_ID=events-management-4d8ce
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
NODE_ENV=production

# Assignment 5 integration. Generate each shared secret independently, for example:
# openssl rand -hex 32
# Give PARTNER_INBOUND_API_KEY and WEBHOOK_INBOUND_SECRET to the partner privately.
# Keep WEBHOOK_OUTBOUND_SECRET private; it must match what their receiver expects.
PARTNER_INBOUND_API_KEY=replace_with_at_least_32_random_characters
WEBHOOK_INBOUND_SECRET=replace_with_a_different_32_character_secret

# Add these after the partner sends its API contract. HTTPS only.
# PARTNER_API_URL=https://partner.example/api/resource
# PARTNER_API_HEADER_NAME=X-Partner-Key
# PARTNER_API_TOKEN=exact_partner_supplied_header_value
# For bearer auth, use header name Authorization and value: Bearer your-token
# PARTNER_WEBHOOK_URL=https://partner.example/webhooks/events
# WEBHOOK_OUTBOUND_SECRET=partner_supplied_webhook_secret

# Render supplies PORT automatically. For local development only:
# PORT=3000
# Change GOOGLE_APPLICATION_CREDENTIALS to your local JSON file's absolute path.
# Run locally with: node --env-file=.env api.mjs (Node.js 22+)
# npm start reads the host environment; it does not automatically load .env.

# Optional: only needed when deliberately running seed.mjs, not for API hosting.
# ORGANIZER_UID=existing_firebase_auth_organizer_uid
# STUDENT_UID=existing_firebase_auth_student_uid
# ORGANIZER_UNIVERSITY_ID=DEMO-ORGANIZER-001
# STUDENT_UNIVERSITY_ID=DEMO-STUDENT-001
