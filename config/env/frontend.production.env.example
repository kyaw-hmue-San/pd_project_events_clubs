# Set these on the build host, or copy to frontend/.env.production.local.
# VITE_* values are embedded in the browser bundle; never put server secrets here.
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id
VITE_API_BASE_URL=https://your-api.example.com
VITE_CAMPUS_TIME_ZONE=Asia/Bangkok
VITE_SCHOOL_EMAIL_DOMAIN=lamduan.mfu.ac.th
VITE_USE_EMULATORS=false
