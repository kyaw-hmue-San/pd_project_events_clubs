# Configure the persistent API host's environment; never copy secrets to Vite.
FIREBASE_PROJECT_ID=your_project_id
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-service-account.json
NODE_ENV=production
FRONTEND_ORIGINS=https://your-frontend.example.com
SCHOOL_EMAIL_DOMAIN=lamduan.mfu.ac.th
# Let the host supply PORT. Credentials are a server-only mounted secret file.

AIML_API_KEY=
AIML_MODEL=google/gemini-2.5-flash
ORGANIZER_AI_AUTO_APPROVE=false
ORGANIZER_AI_POLICY=

# Explicit opt-in after the real partner URL, agreed key and HMAC secret are set.
TEAM10_WORK_ORDERS_ENABLED=false
TEAM10_WORK_ORDER_API_URL=https://maintenanceteam10.vercel.app/api/partner/work-orders
TEAM10_PARTNER_KEY=
WEBHOOK_REQUIRE_HMAC=true
WEBHOOK_INBOUND_SECRET=

# Optional legacy general partner integration; leave blank unless coordinated.
PARTNER_INBOUND_API_KEY=
PARTNER_API_URL=
PARTNER_API_HEADER_NAME=X-Partner-Key
PARTNER_API_TOKEN=
PARTNER_WEBHOOK_URL=
WEBHOOK_OUTBOUND_SECRET=
INTEGRATION_LOG_VIEWER_UIDS=
